{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/tencent/hy4-flash",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "watcher": { "ignore": ["node_modules/**", ".cloudflare/**", "dist/**"] }
}
